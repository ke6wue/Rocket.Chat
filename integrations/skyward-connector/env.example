# --- Skyward Qmlativ (OAuth2 client-credentials, from your district's
#     Integration Access record — Administrative Access > API > Integration) ---
SKYWARD_BASE_URL=https://qmlativ.cdaschools.org/api          # confirm exact path w/ district Skyward admin
SKYWARD_TOKEN_URL=https://qmlativ.cdaschools.org/api/oauth/token
SKYWARD_CLIENT_ID=
SKYWARD_CLIENT_SECRET=
SKYWARD_ENTITY_ID=                # district/building entity scope, if required by your grant
SKYWARD_SCHOOL_YEAR_ID=           # current school year id in Qmlativ

# --- Rocket.Chat fork admin API ---
ROCKETCHAT_BASE_URL=https://chat.yourdistrict.org
ROCKETCHAT_ADMIN_USER_ID=
ROCKETCHAT_ADMIN_TOKEN=           # personal access token for a dedicated provisioning service account, NOT a human admin's login token

# --- Local mapping / audit store ---
SQLITE_PATH=./data/connector.db

# --- Scheduling (used only by `npm run sync:watch`) ---
CRON_SCHEDULE=0 2 * * *           # default: nightly at 02:00

# --- Safety switch: set to "true" only after a reviewed dry run ---
ALLOW_WRITES=false
